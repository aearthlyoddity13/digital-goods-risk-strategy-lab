# Application
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Comma-separated CORS allowlist (no wildcard in production)
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:3000,http://localhost:3000

# Batch endpoint limit (Phase 1)
MAX_BATCH_SIZE=50

# Frontend (when using Vite later)
VITE_API_BASE_URL=http://127.0.0.1:8000
